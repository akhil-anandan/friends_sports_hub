# Friends Sports Hub - Production Environment Variables Template
# Copy this file to .env and configure your production values

DJANGO_SECRET_KEY=your-production-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,friends-sports-hub.onrender.com

# PostgreSQL Database Configuration
DB_NAME=friends_hub
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5433
DB_CONN_MAX_AGE=600
DB_SSLMODE=prefer

# Or provide a single DATABASE_URL:
# DATABASE_URL=postgresql://user:password@host:port/dbname

