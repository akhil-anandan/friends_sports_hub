# Friends Sports Hub Mulayankavu — Production Environment Variables
# Copy this file to .env and fill in production secrets

# 1. Django Core Security
DJANGO_SECRET_KEY=generate_a_random_50_character_secret_key_here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=friendssportshub.com,www.friendssportshub.com,.onrender.com,127.0.0.1,localhost

# 2. Automated WhatsApp Gateway (Optional)
# UltraMsg: https://ultramsg.com (Scan QR with owner number 6238006820 once)
WHATSAPP_ULTRAMSG_INSTANCE=
WHATSAPP_ULTRAMSG_TOKEN=

# Meta WhatsApp Cloud API (Free tier 1,000 conversations/month)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=

